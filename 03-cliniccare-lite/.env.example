# Copy this file to .env and fill in real values. NEVER commit .env.
#
#   cp .env.example .env
#
# The brief requires that secret keys and email credentials come from the
# environment rather than from source code.

# Flask session signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-me

# SMTP account used for notification emails.
# Use a throwaway/test account for demos, never a personal one.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-test-account@example.com
SMTP_PASSWORD=replace-me

# Set to 1 to print emails to the console instead of actually sending them.
# Keep this on during development so you are not rate-limited or blocked.
EMAIL_DRY_RUN=1
